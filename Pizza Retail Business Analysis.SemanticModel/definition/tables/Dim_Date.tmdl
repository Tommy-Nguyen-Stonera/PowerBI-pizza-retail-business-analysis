	hierarchy 'Date Hierarchy'
		lineageTag: d0000001-0000-4000-d000-000000000001

		level Year
			lineageTag: d0000002-0000-4000-d000-000000000002
			column: Year

		level Quarter
			lineageTag: d0000003-0000-4000-d000-000000000003
			column: QuaterNo

		level Month
			lineageTag: d0000004-0000-4000-d000-000000000004
			column: 'MonthName (Short)'

		level Day
			lineageTag: d0000005-0000-4000-d000-000000000005
			column: DayNo

	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR(MIN('Data_pizza'[date]), MAX('Data_pizza'[date])),
				    "Year", YEAR ( [Date] ),
				    "MonthNo", MONTH ( [Date] ),
				    "QuaterNo", QUARTER ( [Date] ),
				    "DayNo", DAY ( [Date] ),
				    "WeekdayNo", WEEKDAY([Date], 2),
				    "MonthName (Full)", FORMAT ( [Date], "mmmm" ),
				    "MonthName (Short)", FORMAT( [Date], "mmm"),
				    "YearMonth", FORMAT ( [Date], "mmm yyyy" ),
				    "DateKey", VALUE ( FORMAT ( [Date], "yyyymmdd" ) ),
				    "Weekday", VALUE ( FORMAT ( [Date], "w" ) ),
				    "ShortWeekdayName", FORMAT ( [Date], "ddd" ),
				    "WeekdayName", FORMAT ( [Date], "dddd" ),
				    "WeekNumber", WEEKNUM([Date], 2),
				    "YearMonthKey", VALUE ( FORMAT ( [Date], "yyyymm" ) ),
				    "isWeekend", SWITCH (VALUE ( FORMAT ( [Date], "w" ) ), 1, "Weekend", 7, "Weekend", "Weekday")
				)

	annotation PBI_Id = 2c25ccbc4091485aaff33fbbf9bc9994

