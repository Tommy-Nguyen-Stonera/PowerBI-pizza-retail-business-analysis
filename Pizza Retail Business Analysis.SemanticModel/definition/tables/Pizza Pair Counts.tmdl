table 'Pizza Pair Counts'
	lineageTag: 59117907-ee46-40b2-b389-f66d8f067925

	column 'Pizza 1'
		dataType: string
		lineageTag: d76b6de5-a14b-4b00-a4e1-ff240dedc745
		summarizeBy: none
		sourceColumn: [Pizza 1]

		annotation SummarizationSetBy = Automatic

	column 'Pizza 2'
		dataType: string
		lineageTag: 94e2136f-4137-4aed-b3c3-54d64b7e98fe
		summarizeBy: none
		sourceColumn: [Pizza 2]

		annotation SummarizationSetBy = Automatic

	column 'Pair Count'
		dataType: int64
		formatString: #,0
		lineageTag: a947334a-01af-4662-8c15-e339f0d817a3
		summarizeBy: sum
		sourceColumn: [Pair Count]

		annotation SummarizationSetBy = Automatic

	partition 'Pizza Pair Counts' = calculated
		mode: import
		source =
				VAR _Base = SUMMARIZE(Data_pizza, Data_pizza[order_id], Data_pizza[name])
				VAR _Left = SELECTCOLUMNS(_Base, "OrderId", Data_pizza[order_id], "Pizza 1", Data_pizza[name])
				VAR _Right = SELECTCOLUMNS(_Base, "OrderId", Data_pizza[order_id], "Pizza 2", Data_pizza[name])
				VAR _Pairs =
				    FILTER(
				        NATURALINNERJOIN(_Left, _Right),
				        [Pizza 1] < [Pizza 2]
				    )
				RETURN
				    GROUPBY(
				        _Pairs,
				        [Pizza 1],
				        [Pizza 2],
				        "Pair Count", COUNTX(CURRENTGROUP(), [OrderId])
				    )

	annotation PBI_Id = 47373eee12a24b80864747cefa30d20e

