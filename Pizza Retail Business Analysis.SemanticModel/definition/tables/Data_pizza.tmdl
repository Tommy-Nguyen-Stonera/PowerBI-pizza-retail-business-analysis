	column Revenue = ```
			
			    Data_pizza[quantity] * Data_pizza[price]
			
			```
		lineageTag: a59baf86-50c6-4de8-9112-4f3f2df3fe67
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Daily Revenue' =
			
			CALCULATE(
			    SUMX(Data_pizza, Data_pizza[quantity] * Data_pizza[price]),
			    ALLEXCEPT(Data_pizza, Data_pizza[date])
			)
		lineageTag: c5e88f97-9182-40aa-aba0-32a46451f926
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DateTime =
			
			Data_pizza[date] + TIME(
			    HOUR(Data_pizza[time]),
			    MINUTE(Data_pizza[time]),
			    SECOND(Data_pizza[time])
			)
		formatString: General Date
		lineageTag: abc55654-20ce-4710-bf5f-1e0bcba53d63
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ingredients
		dataType: string
		lineageTag: aed0ef9c-ee6a-41fc-9103-d50034cfe5e5
		summarizeBy: none
		sourceColumn: ingredients

		annotation SummarizationSetBy = Automatic

	column 'Order Type' =
			VAR CurrentOrder = Data_pizza[order_id]
			VAR UniqueItems = CALCULATE(
			    DISTINCTCOUNT(Data_pizza[name]),
			    ALL(Data_pizza),
			    Data_pizza[order_id] = CurrentOrder
			)
			RETURN IF(UniqueItems > 1, "Multi-Item", "Single-Item")
		lineageTag: 388670b7-5701-4e05-b272-74593730e7f9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

