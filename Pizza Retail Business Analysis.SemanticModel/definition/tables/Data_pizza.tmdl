				    #"Sorted Rows" = Table.Sort(#"Changed Type",{{"date", Order.Ascending}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Sorted Rows",{{"date", type date}, {"time", type time}}),
				    #"Sorted Rows1" = Table.Sort(#"Changed Type1",{{"pizza_id", Order.Ascending}})
				in
