	measure 'Avg Basket Size' = DIVIDE([Total Quantity], [Total Orders])
		formatString: 0.00
		displayFolder: 01 Core KPIs
		lineageTag: a9999999-9999-4999-a999-999999999999

	measure 'Multi-Item Order %' =
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(Data_pizza[order_id]), Data_pizza[Order Type] = "Multi-Item"),
			    [Total Orders]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Order Behavior
		lineageTag: b1111111-1111-4111-b111-111111111111

	measure 'Top 5 Revenue Share' =
			VAR _Top5 = TOPN(5, VALUES(dim_pizza[name]), [Total Revenue], DESC)
			VAR _Top5Rev = CALCULATE([Total Revenue], _Top5)
			RETURN DIVIDE(_Top5Rev, CALCULATE([Total Revenue], ALL(dim_pizza[name])))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Menu Performance
		lineageTag: b2222222-2222-4222-b222-222222222222

	measure 'Revenue Growth MoM %' =
			VAR _Curr = [Total Revenue]
			VAR _Prev = CALCULATE([Total Revenue], DATEADD(Dim_Date[Date], -1, MONTH))
			RETURN IF(ISBLANK(_Prev) || _Prev = 0, BLANK(), DIVIDE(_Curr - _Prev, _Prev))
		formatString: 0.0%;-0.0%;"n/a"
		displayFolder: 02 Temporal
		lineageTag: b3333333-3333-4333-b333-333333333333

	measure 'Latest Month MoM %' =
			VAR _LatestDate = MAX(Data_pizza[date])
			VAR _LatestYM =
			    CALCULATE(
			        MAX(Dim_Date[YearMonthKey]),
			        Dim_Date[Date] = _LatestDate
			    )
			VAR _CurrRev =
			    CALCULATE(
			        [Total Revenue],
			        ALL(Dim_Date),
			        Dim_Date[YearMonthKey] = _LatestYM
			    )
			VAR _PrevRev =
			    CALCULATE(
			        [Total Revenue],
			        ALL(Dim_Date),
			        Dim_Date[YearMonthKey] = _LatestYM - 1
			    )
			RETURN IF(ISBLANK(_PrevRev) || _PrevRev = 0, BLANK(), DIVIDE(_CurrRev - _PrevRev, _PrevRev))
		formatString: 0.0%;-0.0%;"n/a"
		displayFolder: 02 Temporal
		lineageTag: d1111111-1111-4111-d111-111111111111

	measure 'Revenue YoY %' =
			VAR _Curr = [Total Revenue]
			VAR _Prev = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(Dim_Date[Date]))
			RETURN IF(ISBLANK(_Prev) || _Prev = 0, BLANK(), DIVIDE(_Curr - _Prev, _Prev))
		formatString: 0.0%;-0.0%;"n/a"
		displayFolder: 02 Temporal
		lineageTag: c1111111-1111-4111-c111-111111111111

	measure 'Revenue 7D Moving Avg' =
			VAR _Range = DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -7, DAY)
			RETURN DIVIDE(CALCULATE([Total Revenue], _Range), 7)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02 Temporal
		lineageTag: c2222222-2222-4222-c222-222222222222

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Best Selling Size' =
			VAR _TopSize =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(dim_size[pizza_size]),
			            "@qty", CALCULATE([Total Quantity])
			        ),
			        [@qty], DESC
			    )
			RETURN CONCATENATEX(_TopSize, dim_size[pizza_size], ", ")
		displayFolder: 04 Menu Performance
		lineageTag: c3333333-3333-4333-c333-333333333333

	measure 'Category Concentration HHI' =
			VAR _Shares =
			    ADDCOLUMNS(
			        VALUES(dim_pizza[Pizza Category]),
			        "@share",
			            DIVIDE(
			                CALCULATE([Total Revenue]),
			                CALCULATE([Total Revenue], ALL(dim_pizza[Pizza Category]))
			            )
			    )
			RETURN SUMX(_Shares, [@share] * [@share])
		formatString: 0.000
		displayFolder: 04 Menu Performance
		lineageTag: c4444444-4444-4444-c444-444444444444

	measure 'Avg Pizza Price' = AVERAGE(Data_pizza[price])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 01 Core KPIs
		lineageTag: c5555555-5555-4555-c555-555555555555

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Correlation Coefficient' =
			VAR _T =
			    ADDCOLUMNS(
			        VALUES(dim_pizza[Pizza Category]),
			        "@X", CALCULATE([Avg Pizza Price]),
			        "@Y", CALCULATE([Total Quantity])
			    )
			VAR _AvgX = AVERAGEX(_T, [@X])
			VAR _AvgY = AVERAGEX(_T, [@Y])
			VAR _Num  = SUMX(_T, ([@X] - _AvgX) * ([@Y] - _AvgY))
			VAR _DenX = SQRT(SUMX(_T, ([@X] - _AvgX) ^ 2))
			VAR _DenY = SQRT(SUMX(_T, ([@Y] - _AvgY) ^ 2))
			RETURN DIVIDE(_Num, _DenX * _DenY)
		formatString: 0.00
		displayFolder: 04 Menu Performance
		lineageTag: c6666666-6666-4666-c666-666666666666

	measure 'Median Pizza Price' = MEDIANX(VALUES(dim_pizza[name]), CALCULATE([Avg Pizza Price]))
