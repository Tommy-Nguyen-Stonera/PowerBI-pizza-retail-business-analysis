	measure 'Revenue MTD' = CALCULATE([Total Revenue], DATESMTD(Dim_Date[Date]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02 Temporal
		lineageTag: ba303f8c-fe6c-4bd2-8796-7b8354d9aa80

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Revenue MTD Prior' =
			VAR _LatestDate = MAX(Dim_Date[Date])
			VAR _DayOfMonth = DAY(_LatestDate)
			VAR _PrevMonthEnd = EOMONTH(_LatestDate, -1)
			VAR _PrevStart = DATE(YEAR(_PrevMonthEnd), MONTH(_PrevMonthEnd), 1)
			VAR _PrevCutoff = DATE(YEAR(_PrevMonthEnd), MONTH(_PrevMonthEnd), MIN(_DayOfMonth, DAY(_PrevMonthEnd)))
			RETURN
			    CALCULATE(
			        [Total Revenue],
			        DATESBETWEEN(Dim_Date[Date], _PrevStart, _PrevCutoff)
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02 Temporal
		lineageTag: 28e2f200-465a-4d8a-bd21-439502ba6b67

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Revenue Pacing %' =
			VAR _Curr = [Revenue MTD]
			VAR _Prev = [Revenue MTD Prior]
			RETURN IF(ISBLANK(_Prev) || _Prev = 0, BLANK(), DIVIDE(_Curr - _Prev, _Prev))
		formatString: 0.0%;-0.0%;"n/a"
		displayFolder: 02 Temporal
		lineageTag: ba5345d6-b3ba-4c32-8074-245e40caaedb

