	measure 'Cell vs Weekday Avg %' =
			VAR _Curr = [Total Revenue]
			VAR _WkdAvg =
				CALCULATE(
					AVERAGEX(VALUES(Dim_Time[Order Hour]), [Total Revenue]),
					ALL(Dim_Time[Order Hour])
				)
			RETURN DIVIDE(_Curr - _WkdAvg, _WkdAvg)
			formatString: +0.0%;-0.0%;0%
			lineageTag: 2c3e8e4e-673b-451b-8542-99ae6b68dfe9
			displayFolder: 06 Tooltip
		lineageTag: 82142d67-63cc-4e2e-af9b-a697e4402e22

	measure 'Hour Busiest Weekday' =
			VAR _Days = ADDCOLUMNS(VALUES(Dim_Date[WeekdayName]), "_r", CALCULATE([Total Revenue]))
			VAR _Top = TOPN(1, _Days, [_r], DESC)
			RETURN CONCATENATEX(_Top, Dim_Date[WeekdayName], ", ")
			lineageTag: fd260112-e5eb-4b5e-9681-f40adc379d9d
			displayFolder: 06 Tooltip
		lineageTag: 86b9d15c-e614-4c02-ab6a-ad22d715788a

