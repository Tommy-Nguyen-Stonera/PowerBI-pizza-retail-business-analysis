table measurements
	lineageTag: 63141942-39a4-485c-8d02-306907c086f4

	measure 'Total Revenue' = SUMX(Data_pizza, Data_pizza[quantity] * Data_pizza[price])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 01 Core KPIs
		lineageTag: a1111111-1111-4111-a111-111111111111

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Orders' = DISTINCTCOUNT(Data_pizza[order_id])
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: a2222222-2222-4222-a222-222222222222

	measure 'Total Quantity' = SUM(Data_pizza[quantity])
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: a3333333-3333-4333-a333-333333333333

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
