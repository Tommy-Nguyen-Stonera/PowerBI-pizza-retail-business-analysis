	measure 'Active Filter Text' =
			VAR _Cat = SELECTEDVALUE(dim_pizza[Pizza Category], "All categories")
			VAR _Size = SELECTEDVALUE(dim_size[pizza_size], "All sizes")
			VAR _MinDate = MIN(Dim_Date[Date])
			VAR _MaxDate = MAX(Dim_Date[Date])
			VAR _Range = FORMAT(_MinDate, "mmm yyyy") & " to " & FORMAT(_MaxDate, "mmm yyyy")
			RETURN _Cat & ", " & _Size & ", " & _Range
		displayFolder: 05 Context
