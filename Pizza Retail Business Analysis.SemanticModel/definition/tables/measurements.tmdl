		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Weekday Revenue' = CALCULATE([Total Revenue], Dim_Date[WeekdayNo] IN {1,2,3,4,5})
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
