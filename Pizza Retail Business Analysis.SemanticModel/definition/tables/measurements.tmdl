	measure 'SKU Best Pair' =
			VAR _Current = SELECTEDVALUE(dim_pizza[name])
			VAR _Orders = CALCULATETABLE(VALUES(Data_pizza[order_id]), dim_pizza[name] = _Current)
			VAR _Partners =
				CALCULATETABLE(
					SUMMARIZE(Data_pizza, dim_pizza[name], "_c", DISTINCTCOUNT(Data_pizza[order_id])),
					TREATAS(_Orders, Data_pizza[order_id]),
					dim_pizza[name] <> _Current
				)
			VAR _Top = TOPN(1, _Partners, [_c], DESC)
			RETURN IF(ISBLANK(_Current), BLANK(), CONCATENATEX(_Top, dim_pizza[name], ", "))
			lineageTag: 4d122deb-5044-443a-8b4e-aa36a631ce19
			displayFolder: 06 Tooltip
		lineageTag: 7c7e3537-ead4-4b33-ba27-d5f80e14ec62

	measure 'SKU Peak Hour' =
			VAR _Current = SELECTEDVALUE(dim_pizza[name])
			VAR _Hours = ADDCOLUMNS(VALUES(Dim_Time[Order Hour]), "_r", CALCULATE([Total Revenue]))
			VAR _Top = TOPN(1, _Hours, [_r], DESC)
			RETURN
				IF(
					ISBLANK(_Current),
					BLANK(),
					CONCATENATEX(_Top, FORMAT(TIME(Dim_Time[Order Hour], 0, 0), "h AM/PM"), ", ")
				)
			lineageTag: 3dfe0d1e-0d74-44b6-a61f-a83a5ea68d53
			displayFolder: 06 Tooltip
		lineageTag: 80c9beb2-b8b7-423c-a26e-571e2464a246

	measure 'SKU Top Size' =
			VAR _Current = SELECTEDVALUE(dim_pizza[name])
			VAR _Sizes = ADDCOLUMNS(VALUES(dim_size[pizza_size]), "_q", CALCULATE(SUM(Data_pizza[quantity])))
			VAR _Top = TOPN(1, _Sizes, [_q], DESC)
			RETURN IF(ISBLANK(_Current), BLANK(), CONCATENATEX(_Top, dim_size[pizza_size], ", "))
			lineageTag: 33b30702-0f4e-488d-9c25-b68d42222046
			displayFolder: 06 Tooltip
		lineageTag: d1a884f6-93af-4e33-b703-301e8be6ac92

	measure 'Cell Top SKU' =
			VAR _Pizzas = ADDCOLUMNS(VALUES(dim_pizza[name]), "_r", CALCULATE([Total Revenue]))
			VAR _Top = TOPN(1, _Pizzas, [_r], DESC)
