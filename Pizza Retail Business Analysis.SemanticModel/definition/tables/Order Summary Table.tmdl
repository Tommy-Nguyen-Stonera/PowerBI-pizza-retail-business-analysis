table 'Order Summary Table'
	lineageTag: 1b13b507-a7e2-4430-8fd8-8a72a0d455b3

	measure 'Avg Time Between Orders' = ```
			
			AVERAGE('Order Summary Table'[Time Since Previous Order (mins)])
			
			```
		lineageTag: a6299d36-8ed3-40d8-9689-03b052a0d932

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column order_id
		formatString: 0
		lineageTag: a49baf8e-c171-4d30-9f09-22bab40da11d
		summarizeBy: sum
		isNameInferred
		sourceColumn: Data_pizza[order_id]

		annotation SummarizationSetBy = Automatic

	column OrderTime
		formatString: General Date
		lineageTag: 04409fe6-4d9e-4601-ac03-8d852a024985
		summarizeBy: none
		isNameInferred
		sourceColumn: [OrderTime]

		variation Variation
			isDefault
			relationship: ae2bcb3b-152e-486a-889a-7b0fbba9b44f
			defaultHierarchy: LocalDateTable_cc5b4035-f5a7-477a-a4cf-21f98dd2fdef.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Time Since Previous Order (mins)' =
			VAR CurrentTime = [OrderTime]
			VAR CurrentDay = INT(CurrentTime)
			VAR PreviousTime =
			    CALCULATE(
			        MAX('Order Summary Table'[OrderTime]),
			        FILTER(
			            'Order Summary Table',
			            'Order Summary Table'[OrderTime] < CurrentTime &&
			            INT('Order Summary Table'[OrderTime]) = CurrentDay
			        )
			    )
			RETURN IF(ISBLANK(PreviousTime), BLANK(), DATEDIFF(PreviousTime, CurrentTime, MINUTE))
		formatString: 0
		lineageTag: e65a515d-8cd9-4073-a3ff-97758248b959
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'Order Summary Table' = calculated
		mode: import
		source = ```
				
				SUMMARIZE(
				    Data_pizza,
				    Data_pizza[order_id],
				    "OrderTime", MIN(Data_pizza[DateTime])
				)
				
				```

	annotation PBI_Id = 2ade41d669444a8a886a9c5da09ed7fe

